# Salin ke .env dan isi secara lokal. JANGAN commit .env.

# --- Telegram (notification engine) ---
# Dipakai sebagai workflow variable di Shuffle (lihat shuffle/PLAYBOOKS.md).
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Webhook Shuffle, satu per playbook ---
# Tempel URL webhook persis seperti di UI Shuffle, mis.
#   http://localhost:3001/api/v1/hooks/webhook_1234abcd-...
# Initialize-Wazuh.ps1 otomatis mengubahnya ke http://shuffle-backend:5001/... untuk manager.
SHUFFLE_HOOK_PB01_BLOCK=
SHUFFLE_HOOK_PB02_FIM=
SHUFFLE_HOOK_PB03_MALWARE=
SHUFFLE_HOOK_PB04_ACCOUNT=

# --- Alamat Wazuh Manager untuk agent di container web & sensor ---
# Satu mesin   : kosongkan (default alias jaringan "wazuh.manager").
# Dua mesin    : isi IP LAN PC server, mis. WAZUH_MANAGER=192.168.1.50
WAZUH_MANAGER=

# --- Dipakai tests/run-10x.ps1 untuk memeriksa alert & incident di Wazuh Indexer ---
# Dua mesin: ganti localhost dengan IP PC server, mis. https://192.168.1.50:9200
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=SecretPassword
