# CLO3 Suricata rules (dimuat eksklusif dengan `suricata -S`)
alert http any any -> any any (msg:"CLO3 suspicious SQLi probe"; flow:to_server,established; http.uri; content:"union"; nocase; classtype:web-application-attack; sid:1000001; rev:2;)
alert http any any -> any any (msg:"CLO3 suspicious XSS probe"; flow:to_server,established; http.uri; content:"<script"; nocase; classtype:web-application-attack; sid:1000002; rev:2;)
# Skenario 6: port scan. Threshold = 20 paket SYN dari IP yang sama dalam 10 detik;
# "type both" = alert 1x per jendela waktu setelah threshold terlewati.
alert tcp any any -> any any (msg:"CLO3 possible TCP SYN port scan"; flow:stateless; flags:S,12; threshold:type both, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000003; rev:2;)
